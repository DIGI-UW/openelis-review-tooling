# Deploy config for the review-tooling demo. Copy to .env (git-ignored) and fill in.
# Consumed by deploy.sh (local, AWS-side) and exported into the router compose.

# --- domains (the live demo uses these; change for your own deployment) ---
AMR_DOMAIN=amr.openelis-global.org
ANALYZERS_DOMAIN=analyzers.openelis-global.org
GRIST_DOMAIN=grist.openelis-global.org
LETSENCRYPT_EMAIL=devops@example.org
# Set to "true" to hit Let's Encrypt STAGING while iterating (avoids rate limits).
LETSENCRYPT_STAGING=false

# --- OpenELIS app branches built into each subdomain (APP_REPO below) ---
AMR_BRANCH=feat/782-ogc-782-microbiology-mvp-m7-release-surveillance-readiness
ANALYZERS_BRANCH=codex/ogc-1054-analyzer-qc-mvp

# --- repos deploy.sh clones (defaults shown; override only if you fork) ---
# HARNESS_REPO=https://github.com/DIGI-UW/openelis-review-tooling.git
# HARNESS_BRANCH=main
# APP_REPO=https://github.com/DIGI-UW/OpenELIS-Global-2.git

# --- AWS / host (fill in YOUR instance) ---
REGION=us-west-2
INSTANCE_ID=i-0123456789abcdef0
EIP=203.0.113.10
SG_ID=sg-0123456789abcdef0
OS_USER=ubuntu
SSH_KEY=~/.ssh/your-key.pem

# --- on-box layout (three separate checkouts created by deploy.sh) ---
EDGE_DIR=/opt/oe-edge
AMR_DIR=/opt/oe-amr
ANALYZERS_DIR=/opt/oe-analyzers

# --- Grist/Dex state and first-bootstrap secrets ---
# After first bootstrap, both secrets are preserved in GRIST_STATE_DIR/.env.
# Existing host-side values take precedence on every subsequent deployment.
GRIST_STATE_DIR=/home/ubuntu/oe-grist
DEX_GRIST_CLIENT_SECRET=
# bcrypt hash for the Dex reviewer account; quote it in .env to preserve '$'.
DEX_REVIEWER_PASSWORD_HASH=
