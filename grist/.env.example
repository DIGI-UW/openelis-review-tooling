# Copy to ${EDGE_DIR}/.env on the review host through an approved operator
# channel. This file is a template only; never commit the populated .env.

GRIST_DOMAIN=grist.openelis-global.org
GRIST_STATE_DIR=/home/ubuntu/oe-grist
DEX_GRIST_CLIENT_SECRET=replace-with-a-long-random-secret
# Quote the bcrypt hash so the shell preserves '$'.
# The single quotes around the bcrypt hashes are load-bearing: Compose
# interpolates unquoted values, and a bcrypt hash is full of $ segments, so
# without them Dex receives a truncated hash and crash-loops on startup with
# "hashedSecret too short".
DEX_REVIEWER_PASSWORD_HASH='$2y$10$replace-with-a-real-bcrypt-hash'
DEX_ADMIN_PASSWORD_HASH='$2y$10$replace-with-a-real-bcrypt-hash'
