# =============================================================================
# Umbrella reverse proxy — Host-based dispatch to isolated OpenELIS stacks
# =============================================================================
# Rendered by docker-entrypoint.sh via envsubst. Variables:
#   ${AMR_DOMAIN}        — microbiology MVP stack (OGC-782)
#   ${ANALYZERS_DOMAIN}  — analyzer types & mapping stack (OGC-1054, incl. harness)
#   ${PHRASES_DOMAIN}    — Macro Library stack (OGC-788)
#   ${AMR_CERT} ${AMR_KEY} ${ANALYZERS_CERT} ${ANALYZERS_KEY}
#       — per-domain cert paths, resolved by the entrypoint to the Let's Encrypt
#         lineage when present, else a per-domain self-signed fallback.
#
# The backend stacks bind NO host ports; they are reached only over the
# shared external "oe-edge" Docker network by the aliases their override files
# attach: amr-*, analyzers-*, and phrases-*.
#
# DO NOT edit the rendered nginx.conf — edit this template.
# =============================================================================

worker_processes 1;

events { worker_connections 1024; }

http {
    # Docker's embedded DNS. Combined with $variable upstreams below, this defers
    # name resolution to request time, so the router starts and stays up even if a
    # backend stack is not running yet (returns 502 until it is, instead of nginx
    # refusing to start on an unresolvable upstream).
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Frontend responses arrive uncompressed so the router can inject the review
    # widget into HTML. Recompress them here; otherwise the same setting also sends
    # multi-megabyte JavaScript and CSS bundles to reviewers uncompressed.
    gzip on;
    gzip_proxied any;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types application/javascript application/json image/svg+xml text/css text/javascript;

    # WebSocket upgrade passthrough (Grist relies on it).
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ""      close;
    }

    # Server-side cache for the live UAT checklist reads (GET /uat via the read
    # adapter). Lets a brief Grist hiccup serve the last good checklist to the
    # reviewer overlay instead of failing it.
    proxy_cache_path /var/cache/nginx/uat levels=1:2 keys_zone=uat_cache:1m max_size=16m inactive=30m;

    # -------------------------------------------------------------------------
    # HTTP :80 — ACME HTTP-01 challenge for all domains, then redirect to HTTPS.
    # certbot writes tokens under /var/www/certbot for whichever domain is being
    # validated, so all server_names share the same webroot.
    # -------------------------------------------------------------------------
    server {
        listen 80;
        server_name ${AMR_DOMAIN} ${ANALYZERS_DOMAIN} ${PHRASES_DOMAIN} ${GRIST_DOMAIN};

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }
        location / {
            return 301 https://$host$request_uri;
        }
    }
    server {
        listen 80 default_server;
        server_name _;
        return 301 https://$host$request_uri;
    }

    # -------------------------------------------------------------------------
    # phrases.openelis-global.org -> isolated Macro Library stack (OGC-788)
    # -------------------------------------------------------------------------
    server {
        listen 443 ssl;
        http2 on;
        server_name ${PHRASES_DOMAIN};

        ssl_certificate     ${PHRASES_CERT};
        ssl_certificate_key ${PHRASES_KEY};
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers off;

        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $server_name;
        absolute_redirect off;

        location /__review/ {
            alias /etc/nginx/review/;
            types { application/javascript js; application/json json; }
            default_type application/octet-stream;
            add_header Cache-Control "no-store";
        }

        location ~ ^/__review/uat-(?<uat_instance>[a-z0-9_-]+)\.json$ {
            set $uat_up "uat-read";
            proxy_pass http://$uat_up:8585/uat/$uat_instance.json;
            proxy_ignore_headers Cache-Control Expires;
            proxy_cache uat_cache;
            proxy_cache_valid 200 30s;
            proxy_cache_use_stale error timeout updating http_502 http_503 http_504;
            add_header Cache-Control "no-store" always;
            add_header X-UAT-Cache $upstream_cache_status always;
            add_header X-UAT-Source "grist-live" always;
        }

        location ~ ^(?:/api/OpenELIS-Global)?/__review/uat-(?<uat_submit_instance>[a-z0-9_-]+)/submissions$ {
            set $uat_up "uat-read";
            proxy_pass http://$uat_up:8585/uat/$uat_submit_instance/submissions;
            proxy_set_header Host $host;
            add_header Cache-Control "no-store" always;
        }

        location = /__review/target.json {
            alias /etc/nginx/runtime/target-phrases.json;
            default_type application/json;
            add_header Cache-Control "no-store";
        }
        location = /__review/build.json {
            alias /etc/nginx/runtime/target-phrases.json;
            default_type application/json;
            add_header Cache-Control "no-store";
        }

        location / {
            set $phrases_frontend "phrases-frontend";
            proxy_pass http://$phrases_frontend;
            proxy_redirect off;
            proxy_set_header Host localhost;
            proxy_set_header Accept-Encoding "";
            sub_filter_once on;
            sub_filter '</head>' '<script src="/__review/oe-review-widget.js" data-instance="phrases" data-label="Macro Library (OGC-788)"></script></head>';
        }
        location /api/ {
            set $phrases_oe "phrases-oe";
            proxy_pass https://$phrases_oe:8443$request_uri;
            proxy_redirect off;
            proxy_ssl_verify off;
            proxy_ssl_server_name on;
            proxy_set_header Host $host;
        }
        location /rest/ {
            set $phrases_oe "phrases-oe";
            proxy_pass https://$phrases_oe:8443$request_uri;
            proxy_redirect off;
            proxy_ssl_verify off;
            proxy_ssl_server_name on;
            proxy_set_header Host $host;
        }
    }

    # -------------------------------------------------------------------------
    # amr.openelis-global.org  ->  amr stack (build.docker-compose.yml)
    # -------------------------------------------------------------------------
    server {
        listen 443 ssl;
        http2 on;
        server_name ${AMR_DOMAIN};

        ssl_certificate     ${AMR_CERT};
        ssl_certificate_key ${AMR_KEY};
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers off;

        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $server_name;
        absolute_redirect off;

        # Reviewer overlay assets, served locally by the router. This prefix is
        # more specific than "location /", so it wins over the SPA proxy below.
        location /__review/ {
            alias /etc/nginx/review/;
            types { application/javascript js; application/json json; }
            default_type application/octet-stream;
            add_header Cache-Control "no-store";
        }

        # Live UAT checklist: the widget requests /__review/uat-<inst>.json; serve
        # it from Grist (via the read adapter) instead of the static file, so edits
        # in Grist appear immediately. Regex wins over the prefix above.
        location ~ ^/__review/uat-(?<uat_instance>[a-z0-9_-]+)\.json$ {
            set $uat_up "uat-read";
            proxy_pass http://$uat_up:8585/uat/$uat_instance.json;
            proxy_ignore_headers Cache-Control Expires;
            proxy_cache uat_cache;
            proxy_cache_valid 200 30s;
            proxy_cache_use_stale error timeout updating http_502 http_503 http_504;
            add_header Cache-Control "no-store" always;
            # $upstream_cache_status distinguishes a live read (MISS/HIT) from a
            # stale one served because the upstream failed. Without it the response
            # claims "grist-live" either way and a frozen checklist is invisible.
            add_header X-UAT-Cache $upstream_cache_status always;
            add_header X-UAT-Source "grist-live" always;
        }


        # Handing a review in. Under the application's context path on purpose:
        # the servlet container scopes JSESSIONID to /api/OpenELIS-Global, so a
        # submission sent outside it arrives with no cookie at all and the service
        # can only refuse it. The bare prefix is still matched so a widget already
        # loaded in somebody's tab is answered rather than 404'd. Never cached.
        location ~ ^(?:/api/OpenELIS-Global)?/__review/uat-(?<uat_submit_instance>[a-z0-9_-]+)/submissions$ {
            set $uat_up "uat-read";
            proxy_pass http://$uat_up:8585/uat/$uat_submit_instance/submissions;
            proxy_set_header Host $host;
            add_header Cache-Control "no-store" always;
        }

        # Published atomically only after application health verification.
        location = /__review/target.json {
            alias /etc/nginx/runtime/target-amr.json;
            default_type application/json;
            add_header Cache-Control "no-store";
        }
        # Compatibility alias for widgets deployed before the target contract.
        location = /__review/build.json {
            alias /etc/nginx/runtime/target-amr.json;
            default_type application/json;
            add_header Cache-Control "no-store";
        }

        # Frontend. Host is rewritten to "localhost" so a Vite dev server (if the
        # stack runs one) accepts the forwarded request (Vite 5 allowedHosts is
        # strict); harmless for the static-nginx runtime build, which ignores Host.
        # sub_filter injects the reviewer overlay before </head>; Accept-Encoding
        # is cleared so nginx sees uncompressed HTML to substitute into.
        location / {
            set $amr_frontend "amr-frontend";
            proxy_pass http://$amr_frontend;
            proxy_redirect off;
            proxy_set_header Host localhost;
            proxy_set_header Accept-Encoding "";
            sub_filter_once on;
            sub_filter '</head>' '<script src="/__review/oe-review-widget.js" data-instance="amr" data-label="Microbiology MVP (OGC-782)"></script></head>';
        }
        location /api/ {
            set $amr_oe "amr-oe";
            proxy_pass https://$amr_oe:8443$request_uri;
            proxy_redirect off;
            proxy_ssl_verify off;
            proxy_ssl_server_name on;
            proxy_set_header Host $host;
        }
        location /rest/ {
            set $amr_oe "amr-oe";
            proxy_pass https://$amr_oe:8443$request_uri;
            proxy_redirect off;
            proxy_ssl_verify off;
            proxy_ssl_server_name on;
            proxy_set_header Host $host;
        }
    }

    # -------------------------------------------------------------------------
    # analyzers.openelis-global.org  ->  analyzers stack (harness chain)
    # -------------------------------------------------------------------------
    server {
        listen 443 ssl;
        http2 on;
        server_name ${ANALYZERS_DOMAIN};

        ssl_certificate     ${ANALYZERS_CERT};
        ssl_certificate_key ${ANALYZERS_KEY};
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers off;

        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $server_name;
        absolute_redirect off;

        location /__review/ {
            alias /etc/nginx/review/;
            types { application/javascript js; application/json json; }
            default_type application/octet-stream;
            add_header Cache-Control "no-store";
        }

        # Live UAT checklist (see the amr vhost for the rationale).
        location ~ ^/__review/uat-(?<uat_instance>[a-z0-9_-]+)\.json$ {
            set $uat_up "uat-read";
            proxy_pass http://$uat_up:8585/uat/$uat_instance.json;
            proxy_ignore_headers Cache-Control Expires;
            proxy_cache uat_cache;
            proxy_cache_valid 200 30s;
            proxy_cache_use_stale error timeout updating http_502 http_503 http_504;
            add_header Cache-Control "no-store" always;
            # $upstream_cache_status distinguishes a live read (MISS/HIT) from a
            # stale one served because the upstream failed. Without it the response
            # claims "grist-live" either way and a frozen checklist is invisible.
            add_header X-UAT-Cache $upstream_cache_status always;
            add_header X-UAT-Source "grist-live" always;
        }


        # Handing a review in. Same-origin on purpose: the reviewer's session
        # cookie belongs to this host, so a submission from anywhere else would
        # arrive without the one credential the service checks. Never cached.
        location ~ ^(?:/api/OpenELIS-Global)?/__review/uat-(?<uat_submit_instance>[a-z0-9_-]+)/submissions$ {
            set $uat_up "uat-read";
            proxy_pass http://$uat_up:8585/uat/$uat_submit_instance/submissions;
            proxy_set_header Host $host;
            add_header Cache-Control "no-store" always;
        }

        location = /__review/target.json {
            alias /etc/nginx/runtime/target-analyzers.json;
            default_type application/json;
            add_header Cache-Control "no-store";
        }
        location = /__review/build.json {
            alias /etc/nginx/runtime/target-analyzers.json;
            default_type application/json;
            add_header Cache-Control "no-store";
        }

        location / {
            set $an_frontend "analyzers-frontend";
            proxy_pass http://$an_frontend;
            proxy_redirect off;
            proxy_set_header Host localhost;
            proxy_set_header Accept-Encoding "";
            sub_filter_once on;
            sub_filter '</head>' '<script src="/__review/oe-review-widget.js" data-instance="analyzers" data-label="Analyzer Types &amp; Mapping (OGC-1054)"></script></head>';
        }
        location /api/ {
            set $an_oe "analyzers-oe";
            proxy_pass https://$an_oe:8443$request_uri;
            proxy_redirect off;
            proxy_ssl_verify off;
            proxy_ssl_server_name on;
            proxy_set_header Host $host;
        }
        location /rest/ {
            set $an_oe "analyzers-oe";
            proxy_pass https://$an_oe:8443$request_uri;
            proxy_redirect off;
            proxy_ssl_verify off;
            proxy_ssl_server_name on;
            proxy_set_header Host $host;
        }
    }

    # -------------------------------------------------------------------------
    # grist.openelis-global.org -> Grist UAT authoring UI and REST API.
    # Grist authenticates through its OIDC flow against Dex.
    # -------------------------------------------------------------------------
    server {
        listen 443 ssl;
        http2 on;
        server_name ${GRIST_DOMAIN};

        ssl_certificate     ${GRIST_CERT};
        ssl_certificate_key ${GRIST_KEY};
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers off;

        client_max_body_size 32m;

        # Dex IdP endpoints (OIDC discovery/auth/token/keys) under /dex — public,
        # since the browser OIDC flow hits them. No prefix stripping: Dex's issuer
        # path is /dex, so it serves its handlers there.
        location /dex/ {
            set $dex_up "dex";
            proxy_pass http://$dex_up:5556;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Project docs — the tutorial and overview, served from the repo so they
        # are shareable by URL, versioned with the code, and on the same TLS as
        # everything else. Public: they describe the tooling, not any data.
        location /docs/ {
            alias /etc/nginx/docs/;
            index index.html;
            types {
                text/html html;
                text/markdown md;
                application/javascript js;
                text/css css;
                application/json json;
            }
            default_type text/plain;
            charset utf-8;
            add_header Cache-Control "public, max-age=300" always;
        }
        location = /docs {
            return 301 /docs/;
        }

        # ---- central integration surface -------------------------------------
        # These two are what an EXISTING deployment points at to adopt the review
        # overlay: one script tag, no proxy, no frontend build on their side.
        # Both are public and read-only (authoring still requires auth via
        # Grist's authenticated REST API).

        # The reviewer widget itself, served from this central host so integrators
        # reference a URL instead of vendoring a copy of the file.
        location = /oe-review-widget.js {
            alias /etc/nginx/review/oe-review-widget.js;
            default_type application/javascript;
            add_header Access-Control-Allow-Origin "*" always;
            add_header Cache-Control "public, max-age=300" always;
        }

        # A checklist, by instance slug: /uat/<instance>.json. Cross-origin GET so
        # a widget running on any other site can read it directly.
        location ~ ^/uat/(?<uat_instance>[a-z0-9_-]+)\.json$ {
            if ($request_method = OPTIONS) { return 204; }
            set $uat_up "uat-read";
            proxy_pass http://$uat_up:8585/uat/$uat_instance.json;
            proxy_ignore_headers Cache-Control Expires;
            proxy_cache uat_cache;
            proxy_cache_valid 200 30s;
            proxy_cache_use_stale error timeout updating http_502 http_503 http_504;
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type" always;
            add_header Cache-Control "no-store" always;
            # $upstream_cache_status distinguishes a live read (MISS/HIT) from a
            # stale one served because the upstream failed. Without it the response
            # claims "grist-live" either way and a frozen checklist is invisible.
            add_header X-UAT-Cache $upstream_cache_status always;
            add_header X-UAT-Source "grist-live" always;
        }

        # Grist. Login is Grist's own OIDC flow against Dex — no basic-auth gate;
        # Grist redirects unauthenticated users to Dex and exposes its
        # authenticated REST API through this same upstream.
        location / {
            set $grist_up "grist";
            proxy_pass http://$grist_up:8484;
            proxy_redirect off;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # -------------------------------------------------------------------------
    # Catch-all: any other Host lands here. Reuse amr's cert as an arbitrary
    # default (a self-signed fallback always exists) and refuse the connection —
    # no legitimate traffic should reach this block.
    # -------------------------------------------------------------------------
    server {
        listen 443 ssl default_server;
        server_name _;
        ssl_certificate     ${AMR_CERT};
        ssl_certificate_key ${AMR_KEY};
        return 444;
    }
}
