.env
*.pem
*.api-key
mcp-tokens.json
grist.htpasswd
runtime/

# TLS material + ACME state (box-side)
letsencrypt/
certbot/
selfsigned/

# build / deps
node_modules/
npm-debug.log*
test-results/
playwright-report/

# editor / OS / backups
*.bak*
.DS_Store

# Evidence uploaded by reviewers, written on the box. Tracking it would make
# every deploy report a dirty worktree and train people to ignore drift.
widget/evidence/
